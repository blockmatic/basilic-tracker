{
  "name": "@repo/capabilities",
  "version": "0.0.1",
  "private": true,
  "description": "Agent-native capability contracts, registry, and UI context schemas",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --declaration --emitDeclarationOnly",
    "checktypes": "tsc --noEmit",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs"
  },
  "dependencies": {
    "@json-render/core": "0.21.0",
    "@repo/db": "workspace:*",
    "@repo/utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "~26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "^8.5.1",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "zod": "*"
  }
}
